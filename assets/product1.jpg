<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#F8F4E3"/>
      <stop offset="100%" stop-color="#E8DCC8"/>
    </radialGradient>
    <linearGradient id="crust" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4A054"/>
      <stop offset="30%" stop-color="#C4883C"/>
      <stop offset="60%" stop-color="#A06828"/>
      <stop offset="100%" stop-color="#7A4E1E"/>
    </linearGradient>
    <linearGradient id="crustLight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E8C078"/>
      <stop offset="50%" stop-color="#D4A054"/>
      <stop offset="100%" stop-color="#B8843C"/>
    </linearGradient>
    <linearGradient id="highlight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F0D8A0" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#D4A054" stop-opacity="0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
      <feOffset dx="4" dy="6" result="offsetblur"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.3"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
      <feOffset dx="2" dy="3" result="offsetblur"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.2"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect width="600" height="600" fill="url(#bg)"/>
  <ellipse cx="300" cy="520" rx="200" ry="20" fill="#C4A882" opacity="0.3"/>
  <g filter="url(#shadow)" transform="translate(300,300) rotate(-15) translate(-300,-300)">
    <path d="M120,320 Q100,280 130,240 Q160,200 200,190 Q240,180 280,195 Q320,210 360,200 Q400,190 440,210 Q480,230 490,270 Q500,310 480,340 Q460,370 420,380 Q380,390 340,375 Q300,360 260,370 Q220,380 180,370 Q140,360 120,320 Z" fill="url(#crust)"/>
    <path d="M140,310 Q125,275 150,245 Q175,215 210,205 Q245,195 280,208 Q315,220 350,212 Q385,205 420,220 Q455,235 465,265 Q475,295 460,325 Q445,355 410,365 Q375,375 340,362 Q305,350 270,358 Q235,365 200,358 Q165,350 140,310 Z" fill="url(#crustLight)"/>
    <path d="M155,300 Q145,270 165,248 Q185,225 215,218 Q245,210 275,220 Q305,230 335,224 Q365,218 395,230 Q425,242 435,265 Q445,288 432,312 Q420,335 390,345 Q360,355 330,345 Q300,335 270,342 Q240,350 210,345 Q180,340 155,300 Z" fill="url(#highlight)" opacity="0.6"/>
    <path d="M170,295 Q165,275 180,260 Q195,245 215,240 Q235,235 255,242 Q275,250 295,245 Q315,240 335,248 Q355,256 370,270 Q385,284 380,300 Q375,316 355,325 Q335,334 315,328 Q295,322 275,328 Q255,334 235,330 Q215,326 195,318 Q175,310 170,295 Z" fill="#E8C078" opacity="0.4"/>
    <path d="M130,310 Q120,290 135,270 Q150,250 170,245" fill="none" stroke="#8B5E3C" stroke-width="2" opacity="0.3"/>
    <path d="M470,280 Q480,260 465,240 Q450,220 430,215" fill="none" stroke="#8B5E3C" stroke-width="2" opacity="0.3"/>
    <path d="M150,340 Q140,320 155,300" fill="none" stroke="#7A4E1E" stroke-width="1.5" opacity="0.25"/>
    <path d="M450,330 Q460,310 445,290" fill="none" stroke="#7A4E1E" stroke-width="1.5" opacity="0.25"/>
    <path d="M200,200 Q220,195 240,200" fill="none" stroke="#F0D8A0" stroke-width="2" opacity="0.5"/>
    <path d="M350,205 Q370,200 390,208" fill="none" stroke="#F0D8A0" stroke-width="2" opacity="0.5"/>
    <path d="M250,195 Q270,190 290,195" fill="none" stroke="#F0D8A0" stroke-width="1.5" opacity="0.4"/>
    <path d="M180,365 Q200,370 220,368" fill="none" stroke="#7A4E1E" stroke-width="1" opacity="0.2"/>
    <path d="M350,370 Q370,375 390,372" fill="none" stroke="#7A4E1E" stroke-width="1" opacity="0.2"/>
    <ellipse cx="200" cy="250" rx="15" ry="8" fill="#F0D8A0" opacity="0.3" transform="rotate(-20,200,250)"/>
    <ellipse cx="380" cy="240" rx="12" ry="6" fill="#F0D8A0" opacity="0.25" transform="rotate(15,380,240)"/>
    <ellipse cx="300" cy="225" rx="10" ry="5" fill="#F0D8A0" opacity="0.2" transform="rotate(-5,300,225)"/>
  </g>
  <g filter="url(#softShadow)" transform="translate(180,420) rotate(10)">
    <ellipse cx="0" cy="0" rx="35" ry="12" fill="#D4A054"/>
    <ellipse cx="0" cy="-2" rx="30" ry="9" fill="#E8C078" opacity="0.6"/>
  </g>
  <g filter="url(#softShadow)" transform="translate(420,440) rotate(-8)">
    <ellipse cx="0" cy="0" rx="28" ry="10" fill="#C4883C"/>
    <ellipse cx="0" cy="-1" rx="24" ry="7" fill="#D4A054" opacity="0.5"/>
  </g>
  <text x="300" y="560" text-anchor="middle" font-family="'Playfair Display', serif" font-size="22" fill="#8B5E3C" font-weight="600">Butter Croissant</text>
  <text x="300" y="585" text-anchor="middle" font-family="'Source Sans Pro', sans-serif" font-size="13" fill="#8B5E3C" opacity="0.7">Hand-laminated · 27 layers</text>
</svg>