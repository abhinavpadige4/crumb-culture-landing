<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#F8F4E3"/>
      <stop offset="100%" stop-color="#E8DCC8"/>
    </radialGradient>
    <linearGradient id="wrapper" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#D4A574"/>
      <stop offset="100%" stop-color="#A0724A"/>
    </linearGradient>
    <linearGradient id="frosting" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FF6B9D"/>
      <stop offset="50%" stop-color="#E8457A"/>
      <stop offset="100%" stop-color="#C73659"/>
    </linearGradient>
    <linearGradient id="cake" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F5D6A0"/>
      <stop offset="100%" stop-color="#D4A85C"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
      <feOffset dx="0" dy="6" result="offsetblur"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.3"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="softshadow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="4"/>
      <feOffset dx="2" dy="3" result="offsetblur"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.2"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="600" height="600" fill="url(#bg)"/>

  <!-- Decorative dots -->
  <circle cx="80" cy="100" r="4" fill="#6B8E23" opacity="0.3"/>
  <circle cx="520" cy="80" r="3" fill="#8B5E3C" opacity="0.25"/>
  <circle cx="50" cy="450" r="5" fill="#6B8E23" opacity="0.2"/>
  <circle cx="540" cy="500" r="4" fill="#8B5E3C" opacity="0.2"/>
  <circle cx="100" cy="520" r="3" fill="#E8457A" opacity="0.15"/>
  <circle cx="480" cy="150" r="3" fill="#E8457A" opacity="0.15"/>

  <!-- Cupcake group with shadow -->
  <g filter="url(#shadow)" transform="translate(300,320)">

    <!-- Wrapper (cupcake liner) -->
    <path d="M-100,0 L-80,120 Q-80,135 -65,135 L65,135 Q80,135 80,120 L100,0 Z" fill="url(#wrapper)"/>
    <!-- Wrapper pleats -->
    <line x1="-80" y1="5" x2="-65" y2="130" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="-55" y1="5" x2="-45" y2="132" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="-30" y1="5" x2="-25" y2="133" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="-5" y1="5" x2="-3" y2="134" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="20" y1="5" x2="18" y2="134" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="45" y1="5" x2="42" y2="133" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <line x1="70" y1="5" x2="65" y2="130" stroke="#B8845A" stroke-width="1.5" opacity="0.5"/>
    <!-- Wrapper top rim -->
    <ellipse cx="0" cy="0" rx="100" ry="12" fill="#C4956A"/>
    <ellipse cx="0" cy="-2" rx="98" ry="10" fill="#D4A574"/>

    <!-- Cake body visible above wrapper -->
    <ellipse cx="0" cy="-5" rx="95" ry="14" fill="url(#cake)"/>

    <!-- Frosting swirl - bottom layer -->
    <path d="M-90,-10 Q-95,-30 -75,-45 Q-50,-60 -20,-55 Q10,-50 35,-58 Q65,-65 85,-50 Q100,-35 90,-15 Q85,-5 70,-8 Q50,-12 30,-5 Q10,2 -10,-5 Q-30,-12 -50,-5 Q-70,2 -85,-5 Z" fill="url(#frosting)" filter="url(#softshadow)"/>

    <!-- Frosting swirl - middle layer -->
    <path d="M-70,-45 Q-75,-65 -55,-78 Q-30,-90 -5,-85 Q20,-80 40,-88 Q60,-92 72,-78 Q80,-65 70,-50 Q55,-42 35,-48 Q15,-54 -5,-48 Q-25,-42 -45,-48 Q-60,-52 -70,-45 Z" fill="#FF7DAE" filter="url(#softshadow)"/>

    <!-- Frosting swirl - top layer -->
    <path d="M-45,-78 Q-50,-95 -35,-105 Q-15,-115 5,-110 Q25,-105 38,-112 Q50,-115 55,-100 Q58,-88 45,-80 Q30,-74 15,-80 Q0,-85 -15,-80 Q-30,-75 -45,-78 Z" fill="#FF8FB8" filter="url(#softshadow)"/>

    <!-- Frosting peak -->
    <path d="M-15,-105 Q-18,-125 -5,-135 Q8,-140 15,-130 Q20,-120 12,-110 Q5,-105 -15,-105 Z" fill="#FFA0C4"/>

    <!-- Frosting highlights -->
    <ellipse cx="-30" cy="-55" rx="12" ry="6" fill="#FFB0D0" opacity="0.4" transform="rotate(-15,-30,-55)"/>
    <ellipse cx="20" cy="-75" rx="10" ry="5" fill="#FFB0D0" opacity="0.35" transform="rotate(10,20,-75)"/>
    <ellipse cx="-5" cy="-100" rx="8" ry="4" fill="#FFC8DC" opacity="0.4" transform="rotate(-5,-5,-100)"/>

    <!-- Cherry on top -->
    <circle cx="5" cy="-138" r="14" fill="#C41E3A"/>
    <circle cx="5" cy="-138" r="14" fill="none" stroke="#8B0000" stroke-width="1" opacity="0.3"/>
    <ellipse cx="0" cy="-143" rx="5" ry="3" fill="#FF4D6D" opacity="0.5"/>
    <!-- Cherry stem -->
    <path d="M5,-152 Q8,-162 14,-168" stroke="#4A7C2E" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <!-- Cherry leaf -->
    <path d="M14,-168 Q22,-172 26,-166 Q22,-162 14,-168 Z" fill="#6B8E23"/>

    <!-- Sprinkles on frosting -->
    <rect x="-55" y="-50" width="8" height="3" rx="1.5" fill="#FFD700" transform="rotate(30,-51,-48)"/>
    <rect x="-20" y="-65" width="8" height="3" rx="1.5" fill="#4FC3F7" transform="rotate(-20,-16,-63)"/>
    <rect x="15" y="-55" width="8" height="3" rx="1.5" fill="#FFD700" transform="rotate(45,19,-53)"/>
    <rect x="40" y="-60" width="8" height="3" rx="1.5" fill="#81C784" transform="rotate(-30,44,-58)"/>
    <rect x="-40" y="-75" width="7" height="3" rx="1.5" fill="#FF7043" transform="rotate(15,-36,-73)"/>
    <rect x="25" y="-80" width="7" height="3" rx="1.5" fill="#4FC3F7" transform="rotate(-40,28,-78)"/>
    <rect x="-10" y="-90" width="7" height="3" rx="1.5" fill="#FFD700" transform="rotate(60,-6,-88)"/>
    <rect x="35" y="-40" width="7" height="3" rx="1.5" fill="#E040FB" transform="rotate(-15,38,-38)"/>
    <rect x="-65" y="-35" width="7" height="3" rx="1.5" fill="#81C784" transform="rotate(25,-61,-33)"/>
    <rect x="55" y="-30" width="7" height="3" rx="1.5" fill="#FF7043" transform="rotate(-45,58,-28)"/>
    <rect x="-25" y="-30" width="6" height="3" rx="1.5" fill="#E040FB" transform="rotate(10,-22,-28)"/>
    <rect x="10" y="-35" width="6" height="3" rx="1.5" fill="#4FC3F7" transform="rotate(-25,13,-33)"/>

    <!-- Wrapper bottom shadow -->
    <ellipse cx="0" cy="138" rx="70" ry="6" fill="#000000" opacity="0.08"/>
  </g>

  <!-- Subtle text watermark -->
  <text x="300" y="570" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="#8B5E3C" opacity="0.3" letter-spacing="3">CRUMB CULTURE</text>
</svg>